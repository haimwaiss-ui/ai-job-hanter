NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PROJECT_ID=lyroizvcfonhgdsibvqv
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_ORIGIN=http://localhost:3000

# Separate worker process only. These are publishable/operational settings, not service-role credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
REDIS_URL=
AWS_REGION=
TOKEN_VAULT_SECRET_PREFIX=ai-job-hunter/worker-sessions
WORKER_HANDLER_MODULE=
SUBMISSION_ADAPTER_MODULE=

# One-time local provisioning script only. Never add this to NEXT_PUBLIC_* or browser builds.
SUPABASE_SERVICE_ROLE_KEY=
WORKER_USER_ID=
# Optional customer-managed AWS KMS key for worker token secrets.
TOKEN_VAULT_KMS_KEY_ID=

# Server-side web job search provider
TAVILY_API_KEY=

# Server-side AI matching. Never expose as NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google OAuth for read-only Gmail job-email scanning
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte random key encoded as base64; never expose as NEXT_PUBLIC_*
GMAIL_TOKEN_ENCRYPTION_KEY=
