NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_ORIGIN=http://localhost:3000

# Separate worker process only. These are publishable/operational settings, not service-role credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
REDIS_URL=
AWS_REGION=
TOKEN_VAULT_SECRET_PREFIX=ai-job-hunter/worker-sessions
WORKER_HANDLER_MODULE=

# Server-side web job search provider
TAVILY_API_KEY=

# Google OAuth for read-only Gmail job-email scanning
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte random key encoded as base64; never expose as NEXT_PUBLIC_*
GMAIL_TOKEN_ENCRYPTION_KEY=
